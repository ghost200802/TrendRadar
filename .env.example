# ═══════════════════════════════════════════════════════════════
# TrendRadar 环境变量配置模板
# ═══════════════════════════════════════════════════════════════
#
# 使用方法：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 填写你自己的值（去掉行首的 #）
#   3. .env 已被 .gitignore，不会被提交到仓库
#
# 注意：所有配置项均可同时在 config.yaml 中设置，
#       环境变量优先级高于 config.yaml。
#       仅需配置你想覆盖的项即可。
# ═══════════════════════════════════════════════════════════════


# ─── AI 模型配置 ───────────────────────────────────────────────
AI_API_KEY=
AI_API_BASE=
# AI_MODEL=openai/glm-5-turbo


# ─── 推送渠道配置 ──────────────────────────────────────────────

# 飞书
FEISHU_WEBHOOK_URL=

# 钉钉
# DINGTALK_WEBHOOK_URL=

# 企业微信
# WEWORK_WEBHOOK_URL=
# WEWORK_MSG_TYPE=markdown

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# 邮件
# EMAIL_FROM=
# EMAIL_PASSWORD=
# EMAIL_TO=
# EMAIL_SMTP_SERVER=
# EMAIL_SMTP_PORT=

# ntfy
# NTFY_SERVER_URL=https://ntfy.sh
# NTFY_TOPIC=
# NTFY_TOKEN=

# Bark
# BARK_URL=

# Slack
# SLACK_WEBHOOK_URL=

# 通用 Webhook（Discord / Matrix / IFTTT 等）
# GENERIC_WEBHOOK_URL=
# GENERIC_WEBHOOK_TEMPLATE={"content": "{content}"}


# ─── 远程存储配置（S3 兼容协议）────────────────────────────────
# S3_ENDPOINT_URL=
# S3_BUCKET_NAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=


# ─── 其他可选配置 ──────────────────────────────────────────────
# TIMEZONE=Asia/Shanghai
# CONFIG_PATH=config/config.yaml
# STORAGE_BACKEND=auto
# SCHEDULE_PRESET=morning_evening
# AI_TRANSLATION_LANGUAGE=English
